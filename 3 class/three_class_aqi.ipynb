    "def _normalize_interpolated(values):\n",
    "    \"\"\"Give aqi_labels the comma-separated representation written by temp_table.ipynb.\"\"\"\n",
    "    def one(v):\n",
    "        if v is None or (isinstance(v,float) and np.isnan(v)): return \"None\"\n",
    "        if isinstance(v,(list,tuple,set)): return \", \".join(str(x) for x in v) if v else \"None\"\n",
    "        s=str(v).strip()\n",
    "        if s.startswith((\"[\",\"(\")):\n",
    "            try:\n",
    "                parsed=ast.literal_eval(s)\n",
    "                if isinstance(parsed,(list,tuple,set)): return \", \".join(map(str,parsed)) if parsed else \"None\"\n",
    "            except (ValueError,SyntaxError): pass\n",
    "        return \"None\" if s in (\"\", \"[]\", \"None\", \"nan\") else s\n",
    "    return values.map(one)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 41,
   "id": "class3-06",
   "metadata": {},
   "outputs": [],
   "source": [
    "def load_hourly():\n",
    "    \"\"\"Load hourly observations from MySQL, without using any CSV fallback.\"\"\"\n",
    "    # Keep these imports local so this cell still works if notebook cells were run out of order.\n",
    "    from sqlalchemy import create_engine, inspect, text\n",
    "\n",
    "    url = os.environ.get(\"DB_URL\", \"mysql+pymysql://root:@localhost/air_quality\")\n",
    "    engine = None\n",
    "    try:\n",
    "        engine = create_engine(url)\n",
    "        with engine.connect() as con:\n",
    "            tables = set(inspect(con).get_table_names())\n",
    "            if \"all_regions\" in tables:\n",
    "                chunks = pd.read_sql_query(text(\"SELECT * FROM all_regions\"), con, chunksize=50000)\n",
    "                hourly = pd.concat(chunks, ignore_index=True)\n",
    "                used = [\"all_regions\"]\n",
    "            else:\n",
    "                available = [table for table in STATIONS if table in tables]\n",
    "                if not available:\n",
    "                    raise RuntimeError(\"No all_regions or known station tables exist in air_quality.\")\n",
    "                parts = []\n",
    "                for table in available:\n",
    "                    frame = pd.read_sql_query(text(f\"SELECT * FROM `{table}`\"), con)\n",
    "                    if \"station\" not in frame.columns:\n",
    "                        frame[\"station\"] = table\n",
    "                    parts.append(frame)\n",
    "                hourly = pd.concat(parts, ignore_index=True)\n",
    "                used = available\n",
    "    except Exception as exc:\n",
    "        raise RuntimeError(\n",
    "            \"Could not load hourly rows from MySQL database air_quality. \"\n",
    "            \"Check that MySQL is running, DB_URL is correct, and all_regions or station tables exist. \"\n",
    "            f\"Underlying error: {type(exc).__name__}: {exc}\"\n",
    "        ) from exc\n",
    "    finally:\n",
    "        if engine is not None:\n",
    "            engine.dispose()\n",
    "\n",
    "    if hourly.empty:\n",
    "        raise RuntimeError(\"MySQL returned zero rows from the selected air_quality table(s).\")\n",
    "    if \"interpolated_columns\" not in hourly.columns:\n",
    "        raise RuntimeError(\"The MySQL table lacks interpolated_columns. Rebuild all_regions using air-quality-classification/notebooks/temp_table.ipynb.\")\n",
    "    hourly[\"interpolated_columns\"] = _normalize_interpolated(hourly[\"interpolated_columns\"])\n",
    "    print(f\"Loaded {len(hourly):,} hourly rows from MySQL table(s): {', '.join(used)}\")\n",
    "    return hourly, used\n"
   ]
  },
